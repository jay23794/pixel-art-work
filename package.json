{
  "name": "pixelforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders 16-bit pixel-art scenes from JSON scene descriptions into MP4 video.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "capture:golden": "tsx scripts/capture-golden.ts",
    "render": "tsx src/video/cli.ts",
    "import": "tsx src/assets/import-cli.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
